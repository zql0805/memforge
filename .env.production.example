# Memforge 生产环境配置模板
# 复制为 .env.production 并填入实际值（该文件已 gitignored）
#
# 配置优先级：shell 环境变量 > .env.production 文件

# ═══════════════════════════════════════════════════
# 必填 — 缺少任一项服务将无法启动
# ═══════════════════════════════════════════════════

DATABASE_URL=postgresql://memforge:YOUR_PASSWORD@localhost:5432/memforge
REDIS_URL=redis://localhost:6379
JWT_SECRET=至少32字符的随机字符串_用于签发JWT

# ═══════════════════════════════════════════════════
# Embedding API — 向量化服务配置
# ═══════════════════════════════════════════════════

OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=sk-your-api-key
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_DIMENSIONS=1024
EMBEDDING_MODEL_TIER=L3
EMBEDDING_PROVIDER=api

# ═══════════════════════════════════════════════════
# LLM 推理 — Git 提交深度分析 + 自动 Code Review
# 优先级：LLM_* > OPENAI_* / MEMFORGE_LLM_MODEL
# ═══════════════════════════════════════════════════

# 方式 1：LLM_* 系列（推荐，独立于 Embedding 配置）
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-your-llm-api-key
LLM_MODEL=deepseek-ai/DeepSeek-V3

# 方式 2：复用 OPENAI_* + 旧变量（向后兼容）
# MEMFORGE_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ═══════════════════════════════════════════════════
# Git Hook 系统 — Gateway URL（供 hook 安装器写入共享配置）
# ═══════════════════════════════════════════════════

# MEMFORGE_GATEWAY_URL=http://your-server:3000

# ═══════════════════════════════════════════════════
# 功能开关
# ═══════════════════════════════════════════════════

MEMFORGE_GIT_ENGINE=true
MEMFORGE_COMMIT_LEARN=true

# ═══════════════════════════════════════════════════
# 钉钉通知 — 自动 Code Review P0/P1 发现推送
# ═══════════════════════════════════════════════════

# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
# DINGTALK_WEBHOOK_SECRET=SECxxx
# DINGTALK_NOTIFY_ENABLED=true
# DINGTALK_NOTIFY_MIN_SEVERITY=P1
# DINGTALK_QUIET_HOURS=23:00-08:00

# ═══════════════════════════════════════════════════
# WebUI — 通知消息中的链接基础地址
# ═══════════════════════════════════════════════════

# MEMFORGE_WEB_URL=https://memforge.example.com

# ═══════════════════════════════════════════════════
# 安全与网络
# ═══════════════════════════════════════════════════

WEBHOOK_SECRET=your-webhook-secret
CORS_ORIGINS=http://your-domain.com,http://localhost,http://127.0.0.1

# ═══════════════════════════════════════════════════
# 可选 — 端口（默认 3001/3002/3000，如有冲突可修改）
# ═══════════════════════════════════════════════════

# MEMORY_SERVICE_PORT=3001
# RULES_ENGINE_PORT=3002
# GATEWAY_PORT=3000

# ═══════════════════════════════════════════════════
# 可选 — 服务间通信
# ═══════════════════════════════════════════════════

# MEMORY_SERVICE_URL=http://localhost:3001
# KNOWLEDGE_SERVICE_PORT=3003

# ═══════════════════════════════════════════════════
# 可选 — 其他
# ═══════════════════════════════════════════════════

# LOG_LEVEL=info
# MEMFORGE_DEPLOY_DIR=/opt/memforge

# ═══════════════════════════════════════════════════
# GitLab 集成 — Code Review Webhook + MR 自动审查
# ═══════════════════════════════════════════════════

# GITLAB_URL=https://gitlab.example.com
# GITLAB_PRIVATE_TOKEN=glpat-your-token
# GITLAB_ALLOWED_HOSTS=gitlab.example.com

# namespace → product_line 映射（JSON 格式）
# GITLAB_GROUP_MAP={"live":"your-product","lateral":"your-product","trade":"your-product"}

# HTTPS clone URL 中需要去除的前缀（保证 SSH/HTTPS 的 repoId 一致）
# GITLAB_REPO_PREFIX=live

# ═══════════════════════════════════════════════════
# 内部域名检测 — 拓扑扫描时识别内部 URL
# ═══════════════════════════════════════════════════

# 逗号分隔的内部域名后缀列表
# INTERNAL_DOMAINS=example.com,internal.example.com

# ═══════════════════════════════════════════════════
# Hubble 监控 — 流量查询（拓扑流量分析）
# ═══════════════════════════════════════════════════

# HUBBLE_MCP_URL=https://hubble-mcp.example.com/mcp
# HUBBLE_API_KEY=your-hubble-api-key
# HUBBLE_MOA_SOURCE=moa_client_aws
# HUBBLE_NGINX_SOURCE=nginx_aws
# HUBBLE_NGINX_APPKEY_INNER=nginx.monitor.inner/example
# HUBBLE_NGINX_APPKEY_OUTER=nginx.monitor.outer/product/live
# HUBBLE_NGINX_ACTION_INNER=inner/example
# HUBBLE_NGINX_ACTION_OUTER=outer/product/live

# ═══════════════════════════════════════════════════
# 部署相关
# ═══════════════════════════════════════════════════

# MEMFORGE_APP_USER=memforge
# MEMFORGE_SSH_HOST=your-server
# PRODUCT_LINE=your-product
# REPOS_DIR=/opt/memforge/repos

# ═══════════════════════════════════════════════════
# 可选 — VLM 图片描述提取（P3）
# ═══════════════════════════════════════════════════

# VLM_ENABLED=false
# VLM_BASE_URL=                    # OpenAI Vision 兼容 API（如 https://api.siliconflow.cn/v1）
# VLM_API_KEY=
# VLM_MODEL=                       # 如 gpt-4o, glm-4v, Qwen/Qwen2.5-VL-72B-Instruct
# VLM_MAX_TOKENS=300
# VLM_TIMEOUT_MS=30000
