{
  "name": "@memforgeai/knowledge-service",
  "version": "1.0.0",
  "description": "Memforge Knowledge Service - Hybrid search knowledge base for FAQ, technical docs, incidents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
