    "start": "node dist/index.js"
  },
  "dependencies": {
    "@memforgeai/shared": "*",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}