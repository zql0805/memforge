{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.volsier/memforge-memory",
  "description": "Team engineering memory for AI coding assistants. 47 MCP tools, pgvector semantic search.",
  "version": "1.0.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@memforgeai/memory-service",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DATABASE_URL",
          "description": "PostgreSQL connection string",
          "isRequired": true
        },
        {
          "name": "OPENAI_BASE_URL",
          "description": "Embedding API base URL (OpenAI-compatible)",
          "isRequired": true
        },
        {
          "name": "OPENAI_API_KEY",
          "description": "Embedding API key",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "OPENAI_EMBEDDING_MODEL",
          "description": "Embedding model name (e.g. BAAI/bge-m3)",
          "isRequired": true
        }
      ]
    }
  ]
}
